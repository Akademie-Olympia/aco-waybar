// ============================================================================
// WAYBAR - ACO top bar
// Like the macOS menu bar. Left: the Arch logo (system menu), workspace circles
// and the focused app.
// Right: status symbols that only appear when they matter, the clock (opens
// the notification centre) and the control centre.
// Layout only; colours and fonts come from aco-theme via style.css.
// ============================================================================
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,

    "modules-left": ["custom/arch", "hyprland/workspaces", "hyprland/window"],
    "modules-right": ["tray", "privacy", "custom/notifications", "bluetooth", "wireplumber", "backlight", "battery", "network", "custom/control-centre", "clock"],

    "hyprland/window": {
        "format": "{class}",
        "separate-outputs": true,
        "max-length": 32,
        "tooltip": false,
        "rewrite": {
            "kitty": "Terminal",
            "foot": "Terminal",
            "com.mitchellh.ghostty": "Terminal",
            "firefox": "Firefox",
            "obsidian": "Obsidian",
            "org.kde.dolphin": "Dateien",
            "io.github.celluloid_player.Celluloid": "Celluloid",
            "io.bassi.Amberol": "Musik",
            "org.aco.Settings": "Einstellungen",
            "com.gabm.satty": "Screenshot"
        }
    },

    // System menu like the Apple menu: about, settings, apps, update, lock, power.
    "custom/arch": {
        "format": "\uf303",
        "tooltip": false,
        "on-click": "~/.config/hypr/systemmenu.sh"
    },

    // One circle per workspace of this monitor; groups and the "all monitors"
    // mode live in ~/.config/hypr/workspaces.lua, scrolling stays inside the group.
    "hyprland/workspaces": {
        "format": "",
        "all-outputs": false,
        "show-special": false,
        "on-scroll-up": "hyprctl eval 'aco_workspaces.step(-1)'",
        "on-scroll-down": "hyprctl eval 'aco_workspaces.step(1)'"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 10
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} · {signalStrength}%",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}",
        "tooltip-format-disconnected": "Nicht verbunden",
        "on-click": "aco-settings network"
    },

    "wireplumber": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "tooltip-format": "Lautstärke {volume}%",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "aco-settings sound",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "max-volume": 100
    },

    "battery": {
        "interval": 30,
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo} · {power:.1f} W",
        "on-click": "ACO_MENU_DROPDOWN=right ~/.config/hypr/settings.sh power"
    },

    // Laptop screens only; hidden when there is no backlight device.
    "backlight": {
        "format": "{icon}",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip-format": "Helligkeit {percent}%",
        "on-scroll-up": "brightnessctl -e4 -n2 set 2%+",
        "on-scroll-down": "brightnessctl -e4 -n2 set 2%-"
    },

    // Only visible while a device is connected.
    "bluetooth": {
        "format": "",
        "format-connected": "󰂱",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "aco-settings bluetooth"
    },

    // Shows a dot while the microphone or screen sharing is in use.
    "privacy": {
        "icon-size": 13,
        "icon-spacing": 6,
        "transition-duration": 200,
        "modules": [
            { "type": "audio-in", "tooltip": true },
            { "type": "screenshare", "tooltip": true }
        ]
    },

    "clock": {
        // Day and month names follow the system locale (LC_TIME).
        "format": "{:%a %d. %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "interval": 15,
        "on-click": "~/.config/swaync/panel.sh notifications"
    },

    // Only visible while notifications wait or "Nicht stören" is on.
    "custom/notifications": {
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚",
            "none": "",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚",
            "inhibited-none": "",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "tooltip-format": "Mitteilungen (Rechtsklick: Nicht stören)",
        "return-type": "json",
        "exec-if": "command -v swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "~/.config/swaync/panel.sh notifications",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    // Compact control centre below the bar, like on a Mac.
    "custom/control-centre": {
        "format": "󰔡",
        "tooltip-format": "Kontrollzentrum",
        "on-click": "~/.config/swaync/panel.sh control"
    }
}
