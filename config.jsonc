// ============================================================================
// WAYBAR - ACO top bar
// Left: system menu and the focused app. Centre: workspaces. Right: status.
// Layout only; colours and fonts come from aco-theme via style.css.
// ============================================================================
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,

    "modules-left": ["custom/logo", "hyprland/window"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["tray", "network", "wireplumber", "battery", "clock", "custom/notification", "custom/settings"],

    "custom/logo": {
        "format": "",
        "tooltip-format": "System (Rechtsklick: Programme)",
        "menu": "on-click",
        "menu-file": "~/.config/waybar/power_menu.xml",
        "menu-actions": {
            "settings": "~/.config/hypr/settings.sh",
            "appearance": "~/.config/hypr/settings.sh appearance",
            "lock": "hyprlock",
            "logout": "hyprctl dispatch 'hl.dsp.exit()'",
            "suspend": "systemctl suspend",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        },
        "on-click-right": "aco-menu apps"
    },

    "hyprland/window": {
        "format": "{class}",
        "separate-outputs": true,
        "max-length": 32,
        "tooltip": false,
        "rewrite": {
            "kitty": "Terminal",
            "foot": "Terminal",
            "com.mitchellh.ghostty": "Terminal",
            "firefox": "Firefox",
            "obsidian": "Obsidian",
            "pcmanfm": "Dateien",
            "com.gabm.satty": "Screenshot"
        }
    },

    "hyprland/workspaces": {
        "format": "",
        "all-outputs": false,
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r+1\" })'"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 10
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} · {signalStrength}%",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}",
        "tooltip-format-disconnected": "Nicht verbunden",
        "on-click": "kitty -e nmtui"
    },

    "wireplumber": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "tooltip-format": "Lautstärke {volume}%",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "max-volume": 100
    },

    "battery": {
        "interval": 30,
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo} · {power:.1f} W"
    },

    "clock": {
        "format": "{:%d.%m.  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "interval": 15
    },

    "custom/notification": {
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂜",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚",
            "inhibited-none": "󰂜",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "tooltip-format": "Mitteilungen (Rechtsklick: Nicht stören)",
        "return-type": "json",
        "exec-if": "command -v swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "custom/settings": {
        "format": "󰒓",
        "tooltip-format": "Einstellungen",
        "on-click": "~/.config/hypr/settings.sh",
        "on-click-right": "~/.config/hypr/settings.sh appearance"
    }
}
