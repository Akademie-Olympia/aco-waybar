/* Generated by aco-theme from ~/.config/waybar/aco-theme/colors.css.tpl. Do not edit.
 * The bar itself uses the bar style (`aco-theme bar text|opacity`): fg is light
 * or dark to suit the wallpaper, tint is the optional background behind it.
 * Menus and tooltips use the normal palette. */
@define-color fg {{bar_fg}};
@define-color tint {{bar_tint}};
@define-color bar alpha({{bar_tint}}, {{bar_alpha}});
@define-color menu {{surface}};
@define-color menu_text {{text}};
@define-color line {{border:a50}};
@define-color accent {{accent}};
@define-color on_accent {{on_accent}};
@define-color red {{red}};
@define-color yellow {{yellow}};
@define-color orange {{orange}};

* {
    font-family: "{{ui_font}}", "{{icon_font}}", sans-serif;
}

menu,
tooltip {
    border-radius: {{radius}}px;
}

.module,
#workspaces button,
menuitem {
    border-radius: {{radius_small}}px;
}
